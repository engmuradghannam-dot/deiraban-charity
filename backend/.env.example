# انسخ إلى .env محلياً، ولا ترفع الملف الفعلي أو أسرار OAuth إلى Git
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# اترك DATABASE_URL غير مضبوط للتطوير المحلي (SQLite)، واستخدم قاعدة دائمة للإنتاج
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Google OAuth Client من Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
